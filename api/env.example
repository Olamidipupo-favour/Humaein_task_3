# API Environment Configuration
# Copy this file to .env and update with your actual values

# Flask Settings
SECRET_KEY=your-secret-key-here
APP_ENV=dev
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/rcm

# AI/LLM Configuration
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_API_KEY_1=your-second-api-key-here
GOOGLE_API_KEY_2=your-third-api-key-here
MODEL_NAME=gemini-2.5-flash-lite

# CORS Settings
ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,http://147.93.112.143:3001

# API Settings
API_VERSION=v1
MAX_CONTENT_LENGTH=16777216

# Timeouts
REQUEST_TIMEOUT=30
AI_TIMEOUT=60
